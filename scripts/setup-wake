#!/usr/bin/env bash
set -euo pipefail
oma_data="${OMA_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/oma}"
umask 077
mkdir -p "$oma_data/models"
python -m venv "$oma_data/wake-venv"
"$oma_data/wake-venv/bin/pip" install 'vosk==0.3.45'
archive="$(mktemp)"
trap 'rm -f "$archive"' EXIT
curl -fL --max-time 180 https://alphacephei.com/vosk/models/vosk-model-small-ja-0.22.zip -o "$archive"
python - "$archive" "$oma_data/models" <<'PY'
import pathlib,sys,zipfile
root=pathlib.Path(sys.argv[2]).resolve()
with zipfile.ZipFile(sys.argv[1]) as z:
 for entry in z.infolist():
  if not (root/entry.filename).resolve().is_relative_to(root):raise ValueError('Unsafe model path')
 z.extractall(root)
PY
