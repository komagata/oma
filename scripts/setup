#!/usr/bin/env bash
# Explicit machine setup; never run automatically by the shell.
set -euo pipefail
non_interactive=0
install_missing=0
usage() {
  cat <<'HELP'
Usage: scripts/setup [--non-interactive] [--install-missing]
Default: ask before installing dependencies and optional features.
--non-interactive  Never prompt; skip optional echo cancellation, mouse, wake and F8.
--install-missing  In unattended mode, consent to the listed missing required
                  packages and locked npm dependencies. System packages use
                  sudo -n pacman -S --needed --noconfirm; unavailable privilege
                  requires a human terminal. No system upgrade or CLI authentication.
HELP
}
for argument in "$@"; do
  case "$argument" in
    --non-interactive) non_interactive=1 ;;
    --install-missing) install_missing=1 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown setup option: $argument" >&2; usage >&2; exit 2 ;;
  esac
done
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
finish() {
  result=$?
  if (( result )); then
    echo
    echo "Setup did not finish. The error above explains which step failed."
    echo "You can safely run this setup again."
  fi
  if (( ! non_interactive )); then read -r -p "Press Enter to return to O.M.A." _ || true; fi
}
trap finish EXIT
ask() { (( ! non_interactive )) || return 1; local answer; read -r -p "$1 [Y/n] " answer || return 1; [[ "${answer,,}" != n && "${answer,,}" != no ]]; }
install_packages() {
  if pacman -Q "$@" >/dev/null 2>&1; then return 0; fi
  # Machine-wide updates may restart the shell; they belong outside app setup.
  if (( non_interactive )); then
    echo "Installing only these missing required packages: $*"
    if ! sudo -n pacman -S --needed --noconfirm "$@" </dev/null; then
      echo "Package installation failed or terminal privilege is unavailable. Missing packages: $*" >&2
      echo "Open a terminal and run: bash \"$root/scripts/setup\"" >&2
      return 1
    fi
  else
    omarchy pkg add "$@"
  fi
}
echo "O.M.A. — first-time setup"
echo "Check this computer and install the required components."
echo "Your saved conversations and connection settings will be preserved."
echo
python3 "$root/scripts/check-setup.py" | python3 -c 'import json,sys; print(json.load(sys.stdin)["setupMessage"])'
packages=()
while read -r command package; do
  command -v "$command" >/dev/null || packages+=("$package")
done <<'PACKAGES'
node nodejs
npm npm
pw-record pipewire-audio
pw-play pipewire-audio
pw-cli pipewire
wpctl wireplumber
grim grim
wtype wtype
xdg-open xdg-utils
setpriv util-linux
bwrap bubblewrap
secret-tool libsecret
xdg-terminal-exec xdg-terminal-exec
systemd-run systemd
PACKAGES
python3 -c "import numpy" >/dev/null 2>&1 || packages+=(python-numpy)
if command -v node >/dev/null && ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 24 ? 0 : 1)'; then
  echo "Node.js is too old. Update the Node installation selected by your PATH to version 24 or newer, then rerun setup."
  exit 1
fi
if (( ${#packages[@]} )); then
  echo "Required packages: ${packages[*]}"
  if (( non_interactive && install_missing )) || ask "Install missing packages?"; then
    install_packages "${packages[@]}"
  else
    echo "Packages were not installed. Use --non-interactive --install-missing for explicit install consent, or run setup in a terminal."
    exit 1
  fi
fi
if ! (cd "$root" && node --input-type=module -e "await import('openai/resources/live/ws')") >/dev/null 2>&1; then
  if (( non_interactive && install_missing )) || ask "Install the voice conversation dependencies?"; then
    (cd "$root" && npm ci --omit=dev --ignore-scripts --bin-links=false)
  else
    echo "GPT-Live SDK is required. Use --non-interactive --install-missing for explicit install consent, or run SET UP in a terminal."
    exit 1
  fi
fi
echo "Return to O.M.A. after closing this window to connect your AI."
if (( ! non_interactive )) && ! find /usr/lib/spa-0.2/aec -name 'libspa-aec-webrtc.so' -print -quit 2>/dev/null | grep -q .; then
  if ask "Install echo cancellation support?"; then
    install_packages pipewire-audio
  fi
fi
echo "API keys are stored in the secure keyring on this computer."
if ask "Enable mouse control? (optional)"; then
  if ! install_packages gcc wayland || ! "$root/scripts/build-pointer"; then
    echo "Mouse control was not installed. Voice and keyboard control still work; rerun SET UP to retry."
  fi
fi
if ask "Enable voice wake? (optional; downloads Japanese and English recognition models)"; then
  if install_packages python python-pip curl && "$root/scripts/setup-wake"; then
    echo "Enable voice wake in Preferences after connecting your AI."
  else
    echo "Voice wake was not installed. F8 and the bar icon still work; rerun SET UP to retry."
  fi
fi
bindings="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua"
if (( ! non_interactive )) && [[ -f "$bindings" ]] && ! grep -Eq 'io\.github\.komagata\.oma open|shell (open|toggle) io\.github\.komagata\.oma([[:space:]]|$)' "$bindings"; then
  if ! hyprctl -j binds | python3 -c 'import json,sys; sys.exit(1 if any(str(b.get("key","")).upper()=="F8" for b in json.load(sys.stdin)) else 0)'; then
    echo "F8 is assigned or could not be checked. Existing shortcuts were preserved; use the bar icon."
  elif ask "Use F8 to toggle O.M.A.?"; then
    cp -p "$bindings" "$bindings.oma-backup-$(date +%Y%m%d%H%M%S)"
    cat >> "$bindings" <<'OMA_BINDING'

o.bind("F8", "Toggle O.M.A.", [[omarchy-shell -q shell toggle io.github.komagata.oma '{"greet":true}']])
OMA_BINDING
    hyprctl reload
    hyprctl configerrors
  fi
fi
echo
if ! python3 "$root/scripts/check-setup.py" | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r["setupMessage"]); sys.exit(1 if r["setupRequired"] else 0)'; then
  echo "Some dependencies are still unavailable. Review the message above and rerun setup."
  exit 1
fi
/bin/bash "$root/scripts/install-cli"
echo "Computer setup is complete. Runtime dependencies are ready."
if (( ! non_interactive )); then echo "Press Enter to continue in O.M.A."; fi
echo "Voice readiness still requires your API key, task-agent authentication and audio verification."
echo "OpenAI API usage is billed separately from ChatGPT subscriptions."
